# Vessel — server env. Copy to .env and fill. NEVER commit the real .env.
# Public config (safe to expose via /api/config): network, gas station ADDRESS, mint, pricing.
# Secrets (server-only; set as Vercel env vars): API keys, private keys, PAY_SECRET.

PORT=8787
PUBLIC_BASE=http://localhost:8787
STORAGE_BACKEND=shelby
SHELBY_NETWORK=testnet

# Shelby testnet API key (server-only; testnet-scoped key from geomi.dev)
SHELBY_API_KEY=aptoslabs_xxx

# Server storage identity: JSON array (64 bytes) of a Solana keypair. Used for /api/metadata + fallback upload.
SHELBY_SOLANA_SECRET_KEY=[12,34,...]

DAPP_DOMAIN=vessel.demo
MAX_UPLOAD_BYTES=26214400
IPFS_GATEWAY=https://ipfs.io/ipfs/
IPFS_COMPARE_CID=QmT78zSuBmuS4z925WZfrqQ1qHaJ56DQaTfyMUF7F8ff5o

# USDC payments (customer pays the app in stablecoin; the app sponsors Aptos fees — Cách B)
SETTLEMENT_CONTRACTS_ENABLED=false
SETTLEMENT_DEPLOYMENTS_FILE=../../deployments/vessel-settlement.testnet.json
QUOTE_SIGNER_PRIVATE_KEY_B64=
QUOTE_SIGNER_PUBLIC_KEY_HEX=

SOLANA_RPC=https://api.devnet.solana.com
# Legacy direct-transfer receiver (inactive during contract settlement migration).
# SOLANA_TREASURY_SECRET_KEY=
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
PRICE_BASE_USDC=0.01
PRICE_PER_MB_USDC=0.01

# Aptos gas station (sponsor). ACCOUNT is public (fee-payer address); API_KEY is server-only.
GAS_STATION_ACCOUNT=0x...
GAS_STATION_API_KEY=aptoslabs_xxx

# HMAC secret for stateless payment tokens (server-only) — set a long random string on Vercel
PAY_SECRET=change-me-to-a-long-random-string

# Legacy direct-transfer receiver (inactive during contract settlement migration).
# APTOS_TREASURY_ADDRESS=
