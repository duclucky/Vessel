{
  "name": "vessel-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Vessel demo backend — REST API in front of a swappable StorageProvider (mock | shelby).",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "build:client": "node build-client.mjs",
    "test": "node --test test/*.test.js",
    "test:settlement": "node --test test/quote-v1.test.js test/contract-quotes.test.js test/settlement-deployments.test.js test/settlement-adapters.test.js test/contract-settlement-client.test.js test/solana-contract-settlement.test.js test/solana-contract-receipt.test.js",
    "test:ui": "node --test test/*.test.js",
    "check": "npm test && npm run build:client"
  },
  "dependencies": {
    "@anchor-lang/core": "1.1.2",
    "@aptos-labs/gas-station-client": "2.0.3",
    "@aptos-labs/ts-sdk": "5.2.1",
    "@aptos-labs/wallet-standard": "0.5.2",
    "@shelby-protocol/ethereum-kit": "0.1.9",
    "@shelby-protocol/sdk": "^0.6.0",
    "@shelby-protocol/solana-kit": "0.2.8",
    "@solana/spl-token": "0.4.15",
    "@solana/wallet-standard-features": "1.4.0",
    "@solana/web3.js": "1.98.4",
    "@sqds/multisig": "2.1.4",
    "@wallet-standard/app": "1.1.1",
    "@wallet-standard/features": "1.1.1",
    "bs58": "6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.0",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1"
  },
  "overrides": {
    "@aptos-labs/ts-sdk": "5.2.1",
    "rpc-websockets": {
      "uuid": "9.0.1"
    }
  },
  "devDependencies": {
    "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
    "@esbuild-plugins/node-modules-polyfill": "^0.2.2",
    "esbuild": "^0.28.1"
  }
}
